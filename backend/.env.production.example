# Enter these keys privately in Render Environment. Do not commit secrets.
DJANGO_SETTINGS_MODULE=config.settings_production
PYTHON_VERSION=3.13.13
SECRET_KEY=
ALLOWED_HOSTS=api.example.de,novari-backend.onrender.com
DATABASE_URL=
# Internal Render URL uses private networking. External URL: ?sslmode=require.
CORS_ALLOWED_ORIGINS=https://example.de,https://www.example.de
SITE_URL=https://api.example.de
MEDIA_ROOT=/var/data/media
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_TIMEOUT=120
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
NOVARI_NOTIFICATION_EMAIL=
